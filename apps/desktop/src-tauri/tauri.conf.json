{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchOS",
  "version": "0.3.0",
  "identifier": "com.chenxxxxxx06.researchos",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResearchOS",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Chenxxxxxx06",
    "copyright": "Copyright 2024-2026 Chenxxxxxx06. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Evidence-first AI research workspace",
    "longDescription": "ResearchOS connects literature evidence, research missions, code, experiments and paper claims in an auditable desktop workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
